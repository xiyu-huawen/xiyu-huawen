 const canvas=page.locator('.scene-canvas canvas');const b=await canvas.boundingBox();const scene=page.locator('.vessel-scene');const autoBefore=await scene.getAttribute('data-auto-rotating');await page.mouse.move(b.x+b.width*.35,b.y+b.height*.45);await page.mouse.down();await page.mouse.move(b.x+b.width*.42,b.y+b.height*.5,{steps:10});await page.waitForTimeout(50);const manual=await scene.getAttribute('data-auto-rotating');await page.mouse.up();await page.waitForTimeout(1700);const resumed=await scene.getAttribute('data-auto-rotating');
